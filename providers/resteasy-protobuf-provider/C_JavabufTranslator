private static AssignTo toJavabuf(Class<?> javaClass, FieldDescriptor fd) {
   final Field field = javaClass.getDeclaredField(fd.getName());
   field.setAccessible(true);
   AssignTo assignTo = (obj, messageBuilder) -> {
      try {
         if (isSuperClass(fd.getName()) {
            toJavabufMap.get(fd.getType()).assign(obj, messageBuilder);
         } else if toJavabufMap.keySet().contains(fd.getType()) {
            toJavabufMap.get(fd.getType().assign(field.get(obj, messageBuilder);
         } else {
            messageBuilder.setField(fd, field.get(obj));
         }
      } catch (Exception e) {
         \/\/
      }
   };
   return assignTo;
}

private static boolean isSuperClass(String className) {
   return className.endsWith("$$$super");
}
